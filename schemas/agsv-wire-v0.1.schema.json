    },
    "MessageTarget": {
      "description": "Durable routing target.",
      "oneOf": [
        {
          "description": "The active Primary generation.",
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "primary"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "description": "Any current implementation actor for a team.",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/@-]+$"
            },
            "scope": {
              "type": "string",
              "const": "team"
            }
          },
          "required": [
            "scope",
            "id"
          ]
        },
        {
          "description": "One logical actor (its current generation is checked at delivery).",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/@-]+$"
            },
            "scope": {
              "type": "string",
              "const": "actor"
            }
          },
          "required": [
            "scope",
            "id"
          ]
        },
        {
          "description": "All current actors in the workspace.",
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "workspace"
            }
          },
          "required": [
            "scope"
          ]
        }
      ]
    },
    "PrimaryDirective": {
      "description": "A Primary decision that durably constrains a team's work.\n\nThe envelope supplies the affected team, optional request/run scope, fenced\nPrimary identity, and logical addressee. This payload holds only the binding\ndecision and the concise rationale for it.",
      "type": "object",
      "properties": {
        "decision": {
          "description": "Concrete decision that the addressed team or actor must follow.",
          "type": "string",
          "maxLength": 8192,
          "minLength": 1
        },
        "rationale": {
          "description": "Concise reason the decision was made.",
          "type": "string",
          "maxLength": 16384,
          "minLength": 1
        }
      },
      "required": [
        "decision",
        "rationale"
      ]
    },
    "ProgressUpdate": {
      "description": "Periodic implementation progress.",
      "type": "object",
      "properties": {
        "evidence": {
          "description": "Content-addressed supporting evidence.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64
        },
        "percent_complete": {
          "description": "Optional estimated completion percentage.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 100,
          "minimum": 0
        },
        "summary": {
          "description": "Short progress summary.",
          "type": "string",
          "maxLength": 8192,
          "minLength": 1
        }
      },
      "required": [
        "summary",
        "evidence"
      ]
    },
    "QaOutcome": {
      "description": "QA outcome for an exact candidate.",
      "oneOf": [
        {
          "description": "The stated QA checks passed.",
          "type": "string",
          "const": "passed"
        },
        {
          "description": "One or more stated QA checks failed.",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "QaResult": {
      "description": "Provider-independent QA evidence.",
      "type": "object",
      "properties": {
        "candidate": {
          "description": "Exact candidate checked.",
          "$ref": "#/$defs/Candidate"
        },
        "evidence": {
          "description": "Content-addressed QA evidence.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64
        },
        "outcome": {
          "description": "Aggregate outcome.",
          "$ref": "#/$defs/QaOutcome"
        },
        "summary": {
          "description": "Short QA summary.",
          "type": "string",
          "maxLength": 8192,
          "minLength": 1
        }
      },
      "required": [
        "candidate",
        "outcome",
        "summary",
        "evidence"
      ]
    },
    "RequestBaseSource": {
      "description": "Provenance of a request's effective base commit.",
      "oneOf": [
        {
          "description": "The Primary supplied the exact base commit.",
          "type": "string",
          "const": "declared"
        },
        {
          "description": "AGSV derived the base from the assigned team's worktree.",
          "type": "string",
          "const": "derived"
        }
      ]
    },
    "ReviewDecision": {
      "description": "The Primary's decision about an exact candidate.",
      "type": "object",
      "properties": {
        "candidate": {
          "description": "Exact candidate reviewed.",
          "$ref": "#/$defs/Candidate"
        },
        "decision_id": {
          "description": "Stable decision identifier.",
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/@-]+$"
        },
        "evidence": {
          "description": "Content-addressed review evidence.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64
        },
        "policy_revision": {
          "description": "Policy revision used by the review.",
          "type": "integer",
          "minimum": 1
        },
        "rationale": {
          "description": "Human-readable decision rationale.",
          "type": "string",
          "maxLength": 16384,
          "minLength": 1
        },
        "reviewer": {
          "description": "Fenced Primary generation issuing the decision.",
          "$ref": "#/$defs/ActorRef"
        },
        "verdict": {
          "description": "Accepted or rejected.",
          "$ref": "#/$defs/ReviewVerdict"
        }
      },
      "required": [
        "decision_id",
        "candidate",
        "verdict",
        "reviewer",
        "policy_revision",
        "rationale",
        "evidence"
      ]
    },
    "ReviewVerdict": {
      "description": "Review result for an exact candidate.",
      "oneOf": [
        {
          "description": "The exact candidate satisfies the review policy.",
          "type": "string",
          "const": "accepted"
        },
        {
          "description": "The exact candidate requires changes.",
          "type": "string",
          "const": "rejected"
        }
      ]
    },
    "RunControl": {
      "description": "Typed request-scoped run lifecycle command.",
      "type": "object",
      "properties": {
        "action": {
          "description": "Requested run lifecycle operation.",
          "$ref": "#/$defs/RunControlAction"
        }
      },
      "required": [
        "action"
      ]
    },
    "RunControlAction": {
      "description": "Primary-authenticated control applied to a request's run.",
      "oneOf": [
        {
          "description": "Pause active execution without changing the request lifecycle state.",
          "type": "string",
          "const": "pause"
        },
        {
          "description": "Resume execution and move the request back to in-progress work.",
          "type": "string",
          "const": "resume"
        }
      ]
    },
    "TimestampMillis": {
      "description": "Milliseconds since the Unix epoch, supplied by the runtime boundary.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  }
}
