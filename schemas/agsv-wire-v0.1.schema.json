              "$ref": "#/$defs/DependencyNotice"
            }
          },
          "required": [
            "kind",
            "payload"
          ]
        },
        {
          "description": "A team reports a cross-team collision.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "conflict_notice"
            },
            "payload": {
              "$ref": "#/$defs/ConflictNotice"
            }
          },
          "required": [
            "kind",
            "payload"
          ]
        },
        {
          "description": "Current owner proposes a handoff.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
